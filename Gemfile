source "https://rubygems.org"
 
# Pin Jekyll directly instead of the github-pages gem, so local builds
# aren't locked to whatever old Jekyll version github-pages bundles.
gem "jekyll", "~> 4.4"
 
gem "minima", "~> 2.5"
gem "webrick", "~> 1.8"
 
# Plugins used by GitHub's default Jekyll setup - keep whichever you use
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end
 
# Safety nets for gems removed from Ruby's default gems in recent Ruby versions
gem "logger"
gem "csv"
gem "base64"
 
gem "rexml", ">= 3.4.2"
gem "nokogiri", ">= 1.19.3"
gem "addressable", ">= 2.9.0"
gem "faraday", ">= 2.14.2"
